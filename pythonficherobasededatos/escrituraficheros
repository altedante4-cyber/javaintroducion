	try:
		with open(nombre_archivo,"r",encoding="utf-8") as f :
			suma = 0 
			for num_linea , linea in enumerate(f,1) :
				linea_limpia = linea.strip()
				if linea_limpia :
					try:
						suma += float(linea_limpia)
					except ValueError:
						print(f"linea{num_linea)

			return suma 


